{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Ma3mora Inventory Management System - Backend API",
  "main": "dist/index.js",
  "prisma": {
    "seed": "tsx prisma/seed-users-warehouses.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed-users-warehouses.ts",
    "db:studio": "prisma studio",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:reset:force": "prisma migrate reset --force && tsx prisma/seed-all.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "script:remove-wrong-entries": "tsx scripts/remove-wrong-entries.ts",
    "script:check-batch-transactions": "tsx scripts/check-batch-transactions.ts",
    "script:repair-stock-batch-sync": "tsx scripts/repair-stock-batch-sync.ts",
    "script:repair-stock-batch-sync:apply": "tsx scripts/repair-stock-batch-sync.ts --apply",
    "script:recalculate-aggregates": "tsx scripts/recalculate-financial-aggregates.ts",
    "script:recalculate-aggregates:apply": "tsx scripts/recalculate-financial-aggregates.ts --apply",
    "script:clear-treasury": "tsx scripts/clear-treasury-transactions.ts",
    "script:clear-treasury:apply": "tsx scripts/clear-treasury-transactions.ts --apply",
    "script:list-treasury": "tsx scripts/list-treasury-transactions.ts",
    "script:remove-treasury-customers": "tsx scripts/remove-treasury-by-customers.ts",
    "script:remove-treasury-customers:apply": "tsx scripts/remove-treasury-by-customers.ts --apply",
    "script:remove-proc-orders": "tsx scripts/remove-procurement-orders.ts",
    "script:remove-proc-orders:apply": "tsx scripts/remove-procurement-orders.ts --apply",
    "script:remove-invoice-duplicates": "tsx scripts/remove-invoice-duplicates.ts",
    "script:remove-po-duplicates": "tsx scripts/remove-po-duplicates.ts",
    "script:calculate-item-totals": "tsx scripts/calculate-item-totals.ts",
    "script:diagnose-stock": "tsx scripts/diagnose-stock-movements.ts",
    "script:investigate-stock": "tsx scripts/investigate-stock-movement.ts",
    "script:fix-january-stock": "tsx scripts/fix-january-stock-movement.ts",
    "script:backfill-advance-paid-at": "tsx scripts/backfill-advance-paid-at.ts",
    "script:backfill-initial-quantity": "tsx scripts/backfill-initial-quantity.ts",
    "script:backfill-initial-quantity:apply": "tsx scripts/backfill-initial-quantity.ts --apply",
    "script:seed-april-debts": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-april-2026-debts.ts --dry-run",
    "script:seed-april-debts:apply": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-april-2026-debts.ts --confirm",
    "postinstall": "node ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.8.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
