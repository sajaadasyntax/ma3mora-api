// Daily Item Sales Aggregates - Per-item daily sales totals
model DailyItemSalesAggregate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  inventoryId String?
  itemId      String
  section     Section?

  // Quantity aggregates
  totalQuantity Decimal @default(0) @db.Decimal(15, 2)
  totalGiftQty  Decimal @default(0) @db.Decimal(15, 2)

  // Revenue aggregates
  totalAmount      Decimal @default(0) @db.Decimal(15, 2)
  averageUnitPrice Decimal @default(0) @db.Decimal(15, 2)

  // Revenue by payment method (New)
  totalCash     Decimal @default(0) @db.Decimal(15, 2)
  totalBankak   Decimal @default(0) @db.Decimal(15, 2)
  totalBankNile Decimal @default(0) @db.Decimal(15, 2)
  totalDebt     Decimal @default(0) @db.Decimal(15, 2)
  totalOthers   Decimal @default(0) @db.Decimal(15, 2)

  // Count
  invoiceCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([date, inventoryId, itemId, section])
  @@index([date])
  @@index([itemId, date])
  @@index([inventoryId, date])
  @@index([section, date])
  @@map("daily_item_sales_aggregates")
}

// Customer Cumulative Aggregates - Running totals per customer
model CustomerCumulativeAggregate {
  id         String   @id @default(cuid())
  customerId String
  date       DateTime @db.Date

  // Cumulative totals
  totalInvoices    Int     @default(0)
  totalSales       Decimal @default(0) @db.Decimal(15, 2)
  totalPaid        Decimal @default(0) @db.Decimal(15, 2)
  totalOutstanding Decimal @default(0) @db.Decimal(15, 2)

  // By payment method
  salesCash       Decimal @default(0) @db.Decimal(15, 2)
  salesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  salesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  salesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  salesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Account payments (New)
  totalAccountPayments Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, date])
  @@index([customerId])
  @@index([date])
  @@map("customer_cumulative_aggregates")
}

// Supplier Cumulative Aggregates - Running totals per supplier
model SupplierCumulativeAggregate {
  id         String   @id @default(cuid())
  supplierId String
  date       DateTime @db.Date

  // Cumulative totals
  totalOrders      Int     @default(0)
  totalPurchases   Decimal @default(0) @db.Decimal(15, 2)
  totalPaid        Decimal @default(0) @db.Decimal(15, 2)
  totalOutstanding Decimal @default(0) @db.Decimal(15, 2)

  // By payment method
  purchasesCash       Decimal @default(0) @db.Decimal(15, 2)
  purchasesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  purchasesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  purchasesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  purchasesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, date])
  @@index([supplierId])
  @@index([date])
  @@map("supplier_cumulative_aggregates")
}

// Cumulative Balance Snapshots - Daily balance snapshots
model CumulativeBalanceSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  inventoryId String?
  section     Section?

  // Opening balances (cumulative from previous day)
  openingCash     Decimal @default(0) @db.Decimal(15, 2)
  openingBank     Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  openingBankNile Decimal @default(0) @db.Decimal(15, 2)

  // Closing balances (calculated)
  closingCash     Decimal @default(0) @db.Decimal(15, 2)
  closingBank     Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  closingBankNile Decimal @default(0) @db.Decimal(15, 2)

  // Receivables/Payables
  receivablesTotal     Decimal @default(0) @db.Decimal(15, 2)
  payablesTotal        Decimal @default(0) @db.Decimal(15, 2)
  payablesWithExpenses Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([date, inventoryId, section])
  @@index([date])
  @@map("cumulative_balance_snapshots")
}

// ========== GIFT ACCRUAL SYSTEM ==========

enum GiftLedgerEntryType {
  ACCRUAL
  DEDUCTION
  ADJUSTMENT
}

model GiftAccrualRule {
  id         String   @id @default(uuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  giftItemId String
  giftItem   Item     @relation("GiftItem", fields: [giftItemId], references: [id])
  triggerQty Int
  giftQty    Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ledgerEntries SupplierGiftLedger[]

  @@unique([itemId, supplierId])
}

model SupplierGiftLedger {
  id            String              @id @default(uuid())
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  ruleId        String?
  rule          GiftAccrualRule?    @relation(fields: [ruleId], references: [id])
  date          DateTime            @default(now())
  entryType     GiftLedgerEntryType
  description   String?
  itemId        String?
  item          Item?               @relation("GiftLedgerItem", fields: [itemId], references: [id])
  quantity      Int                 @default(0)
  referenceId   String?
  referenceType String?
  createdById   String
  createdBy     User                @relation(fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
}
