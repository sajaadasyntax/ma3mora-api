generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_GROCERY
  SALES_BAKERY
  AGENT_GROCERY
  AGENT_BAKERY
  INVENTORY
  PROCUREMENT
  ACCOUNTANT
  AUDITOR
  MANAGER
}

enum Section {
  GROCERY
  BAKERY
}

enum CustomerType {
  WHOLESALE
  RETAIL
  AGENT
  AGENT_WHOLESALE
  AGENT_RETAIL
  OFFER_1
  OFFER_2
  BAKERY_CUSTOMER
}

enum PaymentMethod {
  CASH
  BANKAK
  BANK_NILE
  COMMISSION
  DEBT
  OTHERS
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

enum DeliveryStatus {
  NOT_DELIVERED
  PARTIAL
  DELIVERED
}

enum PaymentConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ProcOrderStatus {
  CREATED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum BalanceScope {
  CASHBOX
  CUSTOMER
  SUPPLIER
}

// New enums for the enhanced system

enum MovementType {
  INBOUND
  INBOUND_GIFT
  OUTBOUND
  OUTBOUND_GIFT
}

enum WarehouseType {
  MAIN
  ROAD
  SIDE
}

enum JournalEntryType {
  SALE
  PURCHASE
  EXPENSE
  INCOME
  SALARY
  ADVANCE
  CASH_EXCHANGE
  RETURN
  VOID
  TREASURY
  OTHER
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum TreasuryType {
  CASH_IN
  CASH_OUT
}

enum BankakDirection {
  IN
  OUT
}

enum LoanEntityType {
  PERSONAL
  BUSINESS
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  sessionToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accesses                 UserInventoryAccess[]
  salesInvoices            SalesInvoice[]
  procOrders               ProcOrder[]
  expenses                 Expense[]
  income                   Income[]
  auditLogs                AuditLog[]
  salesPayments            SalesPayment[]
  inventoryDelivery        InventoryDelivery[]
  inventoryReceipt         InventoryReceipt[]
  paymentConfirmedOrders   ProcOrder[]           @relation("PaymentConfirmer")
  paymentConfirmedInvoices SalesInvoice[]        @relation("InvoicePaymentConfirmer")
  procOrderPayments        ProcOrderPayment[]
  procOrderReturns         ProcOrderReturn[]
  inventoryTransfers       InventoryTransfer[]
  salaries                 Salary[]
  advances                 Advance[]
  cashExchanges            CashExchange[]
  refundedOrders           ProcOrder[]           @relation("OrderRefunder")
  itemOffers               ItemOffer[]
  customerPayments         CustomerPayment[]
  treasuryTransactions     TreasuryTransaction[]
  bankakTransactions       BankakTransaction[]
  salesDeposits            SalesDeposit[]
  recoveredLoans           RecoveredLoan[]
  salesReturns             SalesReturn[]
  journalEntries           JournalEntry[]
  giftLedgerEntries        SupplierGiftLedger[]

  @@map("users")
}

model Inventory {
  id            String        @id @default(cuid())
  name          String        @unique
  isMain        Boolean       @default(false)
  warehouseType WarehouseType @default(MAIN)

  accesses                   UserInventoryAccess[]
  stocks                     InventoryStock[]
  batches                    StockBatch[]
  salesInvoices              SalesInvoice[]
  procOrders                 ProcOrder[]
  expenses                   Expense[]
  income                     Income[]
  transfersFrom              InventoryTransfer[]         @relation("FromInventory")
  transfersTo                InventoryTransfer[]         @relation("ToInventory")
  stockMovements             StockMovement[]
  dailyFinancialAggregates   DailyFinancialAggregate[]
  monthlyFinancialAggregates MonthlyFinancialAggregate[]
  dailyItemSalesAggregates   DailyItemSalesAggregate[]
  cumulativeBalanceSnapshots CumulativeBalanceSnapshot[]
  itemPrices                 ItemPrice[]

  @@map("inventories")
}

model UserInventoryAccess {
  userId      String
  inventoryId String
  section     Section

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@id([userId, inventoryId, section])
  @@map("user_inventory_access")
}

model Item {
  id        String   @id @default(cuid())
  name      String
  section   Section
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices                   ItemPrice[]
  offers                   ItemOffer[]
  stocks                   InventoryStock[]
  batches                  StockBatch[]
  transfers                InventoryTransfer[]
  movements                StockMovement[]
  salesInvoiceItems        SalesInvoiceItem[]
  procOrderItems           ProcOrderItem[]
  deliveryItems            InventoryDeliveryItem[]
  giftItems                SalesInvoiceItem[]        @relation("GiftItem")
  giftProcItems            ProcOrderItem[]           @relation("GiftProcItem")
  giftDeliveryItems        InventoryDeliveryItem[]   @relation("GiftDeliveryItem")
  dailyItemSalesAggregates DailyItemSalesAggregate[]
  salesReturnItems         SalesReturnItem[]
  giftAccrualRules         GiftAccrualRule[]
  giftAccrualGiftRules     GiftAccrualRule[]         @relation("GiftItem")
  giftLedgerEntries        SupplierGiftLedger[]      @relation("GiftLedgerItem")

  @@map("items")
}

model ItemPrice {
  id          String       @id @default(cuid())
  itemId      String
  inventoryId String? // Nullable for backward compatibility, null means applies to all inventories
  tier        CustomerType
  price       Decimal      @db.Decimal(15, 2)
  validFrom   DateTime     @default(now())

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([itemId, tier, inventoryId])
  @@map("item_prices")
}

model ItemOffer {
  id         String    @id @default(cuid())
  itemId     String
  offerPrice Decimal   @db.Decimal(15, 2)
  validFrom  DateTime  @default(now())
  validTo    DateTime? // Null means offer is active indefinitely
  isActive   Boolean   @default(true)
  notes      String?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  item    Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@index([itemId, isActive])
  @@index([validFrom, validTo])
  @@map("item_offers")
}

model InventoryStock {
  inventoryId String
  itemId      String
  quantity    Decimal @default(0) @db.Decimal(15, 2)

  inventory Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batches   StockBatch[]

  @@id([inventoryId, itemId])
  @@map("inventory_stocks")
}

model StockBatch {
  id          String    @id @default(cuid())
  inventoryId String
  itemId      String
  quantity    Decimal   @db.Decimal(15, 2)
  expiryDate  DateTime?
  receivedAt  DateTime  @default(now())
  receiptId   String?
  notes       String?

  inventory       Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item            Item                     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryStock  InventoryStock?          @relation(fields: [inventoryId, itemId], references: [inventoryId, itemId], onDelete: Cascade)
  receipt         InventoryReceipt?        @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  deliveryBatches InventoryDeliveryBatch[]

  @@index([inventoryId, itemId])
  @@index([expiryDate])
  @@index([receiptId])
  @@map("stock_batches")
}

model InventoryTransfer {
  id              String   @id @default(cuid())
  fromInventoryId String
  toInventoryId   String
  itemId          String
  quantity        Decimal  @db.Decimal(15, 2)
  transferredBy   String
  transferredAt   DateTime @default(now())
  notes           String?

  fromInventory     Inventory @relation("FromInventory", fields: [fromInventoryId], references: [id])
  toInventory       Inventory @relation("ToInventory", fields: [toInventoryId], references: [id])
  item              Item      @relation(fields: [itemId], references: [id])
  transferredByUser User      @relation(fields: [transferredBy], references: [id])

  @@index([fromInventoryId])
  @@index([toInventoryId])
  @@index([itemId])
  @@index([transferredAt])
  @@map("inventory_transfers")
}

// Stock Movement Daily Report Model
// Tracks daily stock movements for inventory items
model StockMovement {
  id              String        @id @default(cuid())
  inventoryId     String
  itemId          String
  movementDate    DateTime      @db.Date
  movementType    MovementType? // New: nullable for backward compat
  openingBalance  Decimal       @db.Decimal(15, 2)
  incoming        Decimal       @default(0) @db.Decimal(15, 2)
  outgoing        Decimal       @default(0) @db.Decimal(15, 2)
  pendingOutgoing Decimal       @default(0) @db.Decimal(15, 2)
  incomingGifts   Decimal       @default(0) @db.Decimal(15, 2)
  outgoingGifts   Decimal       @default(0) @db.Decimal(15, 2)
  closingBalance  Decimal       @db.Decimal(15, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, itemId, movementDate])
  @@index([movementDate])
  @@index([inventoryId, itemId])
  @@map("stock_movements")
}

model Customer {
  id              String       @id @default(cuid())
  name            String
  type            CustomerType
  division        Section
  isAgentCustomer Boolean      @default(false)
  phone           String?
  address         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  salesInvoices        SalesInvoice[]
  openingBalance       OpeningBalance[]
  cumulativeAggregates CustomerCumulativeAggregate[]
  customerPayments     CustomerPayment[]
  treasuryTransactions TreasuryTransaction[]
  bankakTransactions   BankakTransaction[]
  salesDeposits        SalesDeposit[]

  @@index([isAgentCustomer])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  procOrders           ProcOrder[]
  openingBalance       OpeningBalance[]
  cumulativeAggregates SupplierCumulativeAggregate[]
  giftAccrualRules     GiftAccrualRule[]
  giftLedgerEntries    SupplierGiftLedger[]

  @@map("suppliers")
}

model SalesInvoice {
  id                        String                    @id @default(cuid())
  invoiceNumber             String                    @unique
  inventoryId               String
  section                   Section
  salesUserId               String
  customerId                String?
  paymentMethod             PaymentMethod // Kept for backward compat; primary source is SalesPayment records
  paymentStatus             PaymentStatus             @default(CREDIT)
  deliveryStatus            DeliveryStatus            @default(NOT_DELIVERED)
  paymentConfirmationStatus PaymentConfirmationStatus @default(PENDING)
  paymentConfirmedBy        String?
  paymentConfirmedAt        DateTime?
  subtotal                  Decimal                   @db.Decimal(15, 2)
  discount                  Decimal                   @default(0) @db.Decimal(15, 2)
  total                     Decimal                   @db.Decimal(15, 2)
  paidAmount                Decimal                   @default(0) @db.Decimal(15, 2)
  notes                     String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  inventory              Inventory @relation(fields: [inventoryId], references: [id])
  salesUser              User      @relation(fields: [salesUserId], references: [id])
  customer               Customer? @relation(fields: [customerId], references: [id])
  paymentConfirmedByUser User?     @relation("InvoicePaymentConfirmer", fields: [paymentConfirmedBy], references: [id])

  items        SalesInvoiceItem[]
  payments     SalesPayment[]
  deliveries   InventoryDelivery[]
  salesReturns SalesReturn[]

  @@index([paymentConfirmationStatus])
  @@index([deliveryStatus])
  @@index([inventoryId, section])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  itemId       String
  quantity     Decimal  @db.Decimal(15, 2)
  giftQty      Decimal  @default(0) @db.Decimal(15, 2) // Deprecated: kept for backward compatibility
  giftItemId   String? // The item being given as gift (separate from the sold item)
  giftQuantity Decimal? @db.Decimal(15, 2) // Quantity of the gift item
  unitPrice    Decimal  @db.Decimal(15, 2)
  lineTotal    Decimal  @db.Decimal(15, 2)

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item     Item         @relation(fields: [itemId], references: [id])
  giftItem Item?        @relation("GiftItem", fields: [giftItemId], references: [id])

  @@map("sales_invoice_items")
}

model SalesPayment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedBy    String
  notes         String?
  receiptUrl    String?
  receiptNumber String?       @unique

  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedByUser User         @relation(fields: [recordedBy], references: [id])

  @@map("sales_payments")
}

model InventoryDelivery {
  id          String   @id @default(cuid())
  invoiceId   String
  deliveredBy String
  deliveredAt DateTime @default(now())
  notes       String?

  invoice         SalesInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveredByUser User                    @relation(fields: [deliveredBy], references: [id])
  items           InventoryDeliveryItem[]

  @@map("inventory_deliveries")
}

model InventoryDeliveryItem {
  id           String   @id @default(cuid())
  deliveryId   String
  itemId       String
  quantity     Decimal  @db.Decimal(15, 2)
  giftQty      Decimal  @default(0) @db.Decimal(15, 2) // Deprecated: kept for backward compatibility
  giftItemId   String? // The item being given as gift
  giftQuantity Decimal? @db.Decimal(15, 2) // Quantity of the gift item

  delivery InventoryDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item     Item                     @relation(fields: [itemId], references: [id])
  giftItem Item?                    @relation("GiftDeliveryItem", fields: [giftItemId], references: [id])
  batches  InventoryDeliveryBatch[]

  @@map("inventory_delivery_items")
}

model InventoryDeliveryBatch {
  id             String  @id @default(cuid())
  deliveryItemId String
  batchId        String
  quantity       Decimal @db.Decimal(15, 2)

  deliveryItem InventoryDeliveryItem @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade)
  batch        StockBatch            @relation(fields: [batchId], references: [id])

  @@map("inventory_delivery_batches")
}

model ProcOrder {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  inventoryId        String
  section            Section
  createdBy          String
  supplierId         String
  status             ProcOrderStatus @default(CREATED)
  total              Decimal         @db.Decimal(15, 2)
  paidAmount         Decimal         @default(0) @db.Decimal(15, 2)
  paymentConfirmed   Boolean         @default(false)
  paymentConfirmedBy String?
  paymentConfirmedAt DateTime?
  refundMethod       PaymentMethod?
  refundAmount       Decimal?        @db.Decimal(15, 2)
  refundNotes        String?
  refundedBy         String?
  refundedAt         DateTime?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  inventory              Inventory @relation(fields: [inventoryId], references: [id])
  creator                User      @relation(fields: [createdBy], references: [id])
  supplier               Supplier  @relation(fields: [supplierId], references: [id])
  paymentConfirmedByUser User?     @relation("PaymentConfirmer", fields: [paymentConfirmedBy], references: [id])
  refundedByUser         User?     @relation("OrderRefunder", fields: [refundedBy], references: [id])

  items    ProcOrderItem[]
  payments ProcOrderPayment[]
  returns  ProcOrderReturn[]
  receipts InventoryReceipt[]

  @@map("proc_orders")
}

model ProcOrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  itemId             String
  quantity           Decimal  @db.Decimal(15, 2)
  giftQty            Decimal  @default(0) @db.Decimal(15, 2) // Deprecated: kept for backward compatibility
  giftItemId         String? // The item being given as gift (separate from the ordered item)
  giftQuantity       Decimal? @db.Decimal(15, 2) // Quantity of the gift item
  unitCost           Decimal  @db.Decimal(15, 2)
  lineTotal          Decimal  @db.Decimal(15, 2)
  isGiftCompensation Boolean  @default(false) // New: flag extra/gift items during GRN

  order    ProcOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item     Item      @relation(fields: [itemId], references: [id])
  giftItem Item?     @relation("GiftProcItem", fields: [giftItemId], references: [id])

  @@unique([orderId, itemId])
  @@map("proc_order_items")
}

model ProcOrderReturn {
  id         String   @id @default(cuid())
  orderId    String
  reason     String
  returnedBy String
  returnedAt DateTime @default(now())
  notes      String?

  order          ProcOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnedByUser User      @relation(fields: [returnedBy], references: [id])

  @@map("proc_order_returns")
}

model ProcOrderPayment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedBy    String
  notes         String?
  receiptUrl    String?
  receiptNumber String?       @unique
  updatedAt     DateTime      @updatedAt

  order          ProcOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedByUser User      @relation(fields: [recordedBy], references: [id])

  @@map("proc_order_payments")
}

model InventoryReceipt {
  id         String   @id @default(cuid())
  orderId    String
  receivedBy String
  receivedAt DateTime @default(now())
  notes      String?
  updatedAt  DateTime @updatedAt

  order          ProcOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedByUser User         @relation(fields: [receivedBy], references: [id])
  batches        StockBatch[]

  @@map("inventory_receipts")
}

model Expense {
  id            String        @id @default(cuid())
  inventoryId   String?
  section       Section?
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  description   String
  isDebt        Boolean       @default(false)
  expenseHeadId String? // New: link to expense category hierarchy
  createdBy     String
  createdAt     DateTime      @default(now())

  inventory   Inventory?   @relation(fields: [inventoryId], references: [id])
  creator     User         @relation(fields: [createdBy], references: [id])
  expenseHead ExpenseHead? @relation(fields: [expenseHeadId], references: [id])

  @@index([isDebt])
  @@index([expenseHeadId])
  @@map("expenses")
}

model Income {
  id          String        @id @default(cuid())
  inventoryId String?
  section     Section?
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod
  description String
  isDebt      Boolean       @default(false)
  createdBy   String
  createdAt   DateTime      @default(now())

  inventory Inventory? @relation(fields: [inventoryId], references: [id])
  creator   User       @relation(fields: [createdBy], references: [id])

  @@index([isDebt])
  @@map("income")
}

model OpeningBalance {
  id            String        @id @default(cuid())
  scope         BalanceScope
  refId         String?
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @default(CASH)
  openedAt      DateTime      @default(now())
  closedAt      DateTime?
  isClosed      Boolean       @default(false)
  notes         String?

  customer Customer? @relation(fields: [refId], references: [id], map: "opening_balance_customer_fkey")
  supplier Supplier? @relation(fields: [refId], references: [id], map: "opening_balance_supplier_fkey")

  @@index([scope, isClosed, paymentMethod])
  @@map("opening_balances")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  position  String
  phone     String?
  address   String?
  salary    Decimal  @db.Decimal(15, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaries     Salary[]
  advances     Advance[]
  loanBalances EmployeeLoanBalance[]

  @@map("employees")
}

model Salary {
  id                 String        @id @default(cuid())
  employeeId         String
  amount             Decimal       @db.Decimal(15, 2)
  month              Int
  year               Int
  paymentMethod      PaymentMethod @default(CASH)
  paidAt             DateTime?
  deductions         Decimal       @default(0) @db.Decimal(15, 2) // New: total deductions from advances
  netAmount          Decimal       @default(0) @db.Decimal(15, 2) // New: amount - deductions
  openingLoanBalance Decimal       @default(0) @db.Decimal(15, 2) // New: loan balance at start of month
  closingLoanBalance Decimal       @default(0) @db.Decimal(15, 2) // New: loan balance after salary payment
  notes              String?
  createdBy          String
  createdAt          DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([employeeId, month, year])
  @@map("salaries")
}

model Advance {
  id               String        @id @default(cuid())
  employeeId       String
  amount           Decimal       @db.Decimal(15, 2)
  reason           String
  paymentMethod    PaymentMethod @default(CASH)
  paidAt           DateTime?
  remainingBalance Decimal       @default(0) @db.Decimal(15, 2) // New: tracks unpaid portion
  isFullyPaid      Boolean       @default(false) // New: true when fully deducted from salary
  notes            String?
  createdBy        String
  createdAt        DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@map("advances")
}

model CashExchange {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(15, 2)
  fromMethod    PaymentMethod
  toMethod      PaymentMethod
  receiptNumber String?       @unique
  receiptUrl    String?
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())

  createdByUser User @relation(fields: [createdBy], references: [id])

  @@map("cash_exchanges")
}

// ========== NEW MODELS ==========

// Expense Group -> Expense Head hierarchy for categorized expense tracking
model ExpenseGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  heads ExpenseHead[]

  @@map("expense_groups")
}

model ExpenseHead {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  createdAt DateTime @default(now())

  group    ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([groupId, name])
  @@map("expense_heads")
}

// Account-based customer payments (not linked to specific invoices)
model CustomerPayment {
  id              String        @id @default(cuid())
  customerId      String
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  referenceNumber String?
  receiptUrl      String?
  notes           String?
  recordedBy      String
  createdAt       DateTime      @default(now())

  customer       Customer @relation(fields: [customerId], references: [id])
  recordedByUser User     @relation(fields: [recordedBy], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_payments")
}

// Treasury (Cash Office) transactions
model TreasuryTransaction {
  id              String        @id @default(cuid())
  type            TreasuryType
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  customerId      String? // Optional: link to customer for debits
  description     String
  referenceNumber String?
  createdBy       String
  createdAt       DateTime      @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  creator  User      @relation(fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("treasury_transactions")
}

// Bankak (Digital Bank) transactions with reference tracking
model BankakTransaction {
  id              String          @id @default(cuid())
  amount          Decimal         @db.Decimal(15, 2)
  direction       BankakDirection
  referenceNumber String?
  customerId      String? // Optional: link to customer
  description     String
  createdBy       String
  createdAt       DateTime        @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  creator  User      @relation(fields: [createdBy], references: [id])

  @@index([referenceNumber])
  @@index([customerId])
  @@index([createdAt])
  @@map("bankak_transactions")
}

// Sales Deposits (advance payments from customers)
model SalesDeposit {
  id          String        @id @default(cuid())
  customerId  String
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod
  description String?
  createdBy   String
  createdAt   DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("sales_deposits")
}

// Recovered Loans (personal/business loans repaid to company)
model RecoveredLoan {
  id          String         @id @default(cuid())
  entityName  String
  entityType  LoanEntityType
  amount      Decimal        @db.Decimal(15, 2)
  method      PaymentMethod
  description String?
  createdBy   String
  createdAt   DateTime       @default(now())

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdAt])
  @@map("recovered_loans")
}

// Sales Returns
model SalesReturn {
  id         String   @id @default(cuid())
  invoiceId  String
  reason     String
  returnedBy String
  returnedAt DateTime @default(now())
  notes      String?

  invoice        SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  returnedByUser User              @relation(fields: [returnedBy], references: [id])
  items          SalesReturnItem[]

  @@index([invoiceId])
  @@index([returnedAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  itemId    String
  quantity  Decimal @db.Decimal(15, 2)
  unitPrice Decimal @db.Decimal(15, 2)
  lineTotal Decimal @db.Decimal(15, 2)

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])

  @@map("sales_return_items")
}

// Master Journal - records every transaction for daily session summaries
model JournalEntry {
  id            String               @id @default(cuid())
  date          DateTime             @db.Date
  entryType     JournalEntryType
  referenceId   String // ID of the source record (invoice, order, expense, etc.)
  referenceType String // Table/entity name of the source
  direction     TransactionDirection
  amount        Decimal              @db.Decimal(15, 2)
  method        PaymentMethod?
  description   String
  createdBy     String
  createdAt     DateTime             @default(now())

  creator User @relation(fields: [createdBy], references: [id])

  @@index([date])
  @@index([entryType, date])
  @@index([referenceId, referenceType])
  @@map("journal_entries")
}

// Employee Loan Balance tracking (monthly carry-over)
model EmployeeLoanBalance {
  id             String  @id @default(cuid())
  employeeId     String
  month          Int
  year           Int
  openingBalance Decimal @default(0) @db.Decimal(15, 2)
  advancesTaken  Decimal @default(0) @db.Decimal(15, 2)
  deductions     Decimal @default(0) @db.Decimal(15, 2)
  closingBalance Decimal @default(0) @db.Decimal(15, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@map("employee_loan_balances")
}

// ========== AGGREGATE MODELS ==========

// Daily Financial Aggregates - Cumulative daily totals for all financial transactions
model DailyFinancialAggregate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  inventoryId String?
  section     Section?

  // Sales aggregates
  salesTotal    Decimal @default(0) @db.Decimal(15, 2)
  salesReceived Decimal @default(0) @db.Decimal(15, 2)
  salesDebt     Decimal @default(0) @db.Decimal(15, 2)
  salesCount    Int     @default(0)

  // Sales by payment method
  salesCash       Decimal @default(0) @db.Decimal(15, 2)
  salesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK (renamed from BANK)
  salesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  salesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New: DEBT payment method
  salesOthers     Decimal @default(0) @db.Decimal(15, 2) // New: OTHERS payment method

  // Procurement aggregates
  procurementTotal     Decimal @default(0) @db.Decimal(15, 2)
  procurementPaid      Decimal @default(0) @db.Decimal(15, 2)
  procurementDebt      Decimal @default(0) @db.Decimal(15, 2)
  procurementCount     Int     @default(0)
  procurementCancelled Decimal @default(0) @db.Decimal(15, 2)

  // Procurement by payment method
  procurementCash       Decimal @default(0) @db.Decimal(15, 2)
  procurementBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  procurementBankNile   Decimal @default(0) @db.Decimal(15, 2)
  procurementDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  procurementOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Expenses aggregates
  expensesTotal Decimal @default(0) @db.Decimal(15, 2)
  expensesCount Int     @default(0)

  // Expenses by payment method
  expensesCash       Decimal @default(0) @db.Decimal(15, 2)
  expensesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  expensesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  expensesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  expensesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Income aggregates
  incomeTotal Decimal @default(0) @db.Decimal(15, 2)
  incomeCount Int     @default(0)

  // Income by payment method
  incomeCash       Decimal @default(0) @db.Decimal(15, 2)
  incomeBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  incomeBankNile   Decimal @default(0) @db.Decimal(15, 2)
  incomeDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  incomeOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Salaries aggregates
  salariesTotal      Decimal @default(0) @db.Decimal(15, 2)
  salariesCount      Int     @default(0)
  salariesCash       Decimal @default(0) @db.Decimal(15, 2)
  salariesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  salariesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  salariesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  salariesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Advances aggregates
  advancesTotal      Decimal @default(0) @db.Decimal(15, 2)
  advancesCount      Int     @default(0)
  advancesCash       Decimal @default(0) @db.Decimal(15, 2)
  advancesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  advancesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  advancesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  advancesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Cash exchanges (net impact)
  cashExchangesCash       Decimal @default(0) @db.Decimal(15, 2)
  cashExchangesBank       Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  cashExchangesBankNile   Decimal @default(0) @db.Decimal(15, 2)
  cashExchangesDebtMethod Decimal @default(0) @db.Decimal(15, 2) // New
  cashExchangesOthers     Decimal @default(0) @db.Decimal(15, 2) // New

  // Treasury aggregates (New)
  treasuryInflow  Decimal @default(0) @db.Decimal(15, 2)
  treasuryOutflow Decimal @default(0) @db.Decimal(15, 2)

  // Customer account payments (New)
  customerPaymentsTotal Decimal @default(0) @db.Decimal(15, 2)
  customerPaymentsCount Int     @default(0)

  // Sales returns (New)
  salesReturnsTotal Decimal @default(0) @db.Decimal(15, 2)
  salesReturnsCount Int     @default(0)

  // Net calculations (calculated fields, updated on aggregate changes)
  netCash     Decimal @default(0) @db.Decimal(15, 2)
  netBank     Decimal @default(0) @db.Decimal(15, 2) // Tracks BANKAK
  netBankNile Decimal @default(0) @db.Decimal(15, 2)
  netDebt     Decimal @default(0) @db.Decimal(15, 2) // New
  netOthers   Decimal @default(0) @db.Decimal(15, 2) // New
  netTotal    Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([date, inventoryId, section])
  @@index([date])
  @@index([inventoryId, date])
  @@index([section, date])
  @@map("daily_financial_aggregates")
}

